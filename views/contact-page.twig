{% extends "base.twig" %}

{% block content %}

<section class="page-hero contact-hero">
    <div class="container">

        <span class="section-eyebrow">
            Get In Touch
        </span>

        <h1>Contact Dessert Affairs</h1>

        <p>
            Have a question, need a custom order,
            or want to enquire about catering?
            We'd love to hear from you.
        </p>

    </div>
</section>


<section class="contact-section">

    <div class="container contact-grid">

        <div class="contact-details">

            <span class="section-eyebrow">
                Contact Details
            </span>

            <h2>Let's Talk Desserts</h2>

            <p>
                Whether you're planning a celebration,
                looking for something sweet, or have a
                question about an order, get in touch.
            </p>

        </div>


        <div class="contact-form-wrapper">

            <span class="section-eyebrow">
                Send A Message
            </span>

            <h2>How Can We Help?</h2>

            <div class="contact-form">

                {% set contact_form_shortcode =
                    function(
                        'get_field',
                        'contact_form_shortcode'
                    )
                %}

                {% if contact_form_shortcode %}

                    {{
                        function(
                        'do_shortcode',
                            contact_form_shortcode
                        )
                    }}

                {% else %}

                    <p>
                        The contact form is currently unavailable.
                    </p>

                {% endif %}

            </div>

        </div>

    </div>

</section>

{% endblock %}