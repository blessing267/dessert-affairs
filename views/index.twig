{% extends "base.twig" %}

{% block content %}

<section class="page-content">

    <div class="container">

        {% if post %}

            <h1>{{ post.title }}</h1>

            <div class="entry-content">
                {{ post.content }}
            </div>

        {% elseif posts %}

            {% for post in posts %}

                <article>

                    <h2>
                        <a href="{{ post.link }}">
                            {{ post.title }}
                        </a>
                    </h2>

                    <div>
                        {{ post.preview }}
                    </div>

                </article>

            {% endfor %}

        {% endif %}

    </div>

</section>

{% endblock %}