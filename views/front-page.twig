{% extends "base.twig" %}

{% block content %}

<section
    class="hero"
    {% if hero_image %}
        style="
            background-image:
            linear-gradient(
                rgba(0, 0, 0, 0.35),
                rgba(0, 0, 0, 0.35)
            ),
            url('{{ hero_image.url }}');
        "
    {% endif %}
>
    <div class="container hero-content">

        <h1 class="site-title">
            {{ hero_title ?: 'Welcome to Dessert Affairs' }}
        </h1>

        <p class="tagline">
            {{
                hero_text
                ?: 'Sweet treats, cakes and indulgent moments.'
            }}
        </p>

        <a
            href="{{ function(
                'get_post_type_archive_link',
                'product'
            ) }}"
            class="btn"
        >
            {{
                hero_button_text
                ?: 'Shop Desserts'
            }}
        </a>

    </div>
</section>


<section class="featured-products">

    <div class="container">

        <div class="section-heading">
            <span class="section-eyebrow">
                Our favourites
            </span>

            <h2>Featured Desserts</h2>

            <p>
                Discover some of our favourite treats,
                made for every sweet occasion.
            </p>
        </div>

        <div class="woocommerce-products">
            {{
                function(
                    'do_shortcode',
                    '[products limit="4" columns="4" visibility="featured"]'
                )
            }}
        </div>

        <div class="section-action">
            <a
                href="{{ function(
                    'get_post_type_archive_link',
                    'product'
                ) }}"
                class="btn"
            >
                View All Desserts
            </a>
        </div>

    </div>

</section>


<section class="about-section">

    <div class="container about-inner">

        <div class="about-content">

            <span class="section-eyebrow">
                Our Story
            </span>

            <h2>
                {{
                    about_title
                    ?: 'About Dessert Affairs'
                }}
            </h2>

            <p>
                {{
                    about_text
                    ?: 'We create memorable desserts,
                    cakes and treats for every occasion.'
                }}
            </p>

            <a
                href="{{ site.url }}/about/"
                class="text-link"
            >
                Discover our story →
            </a>

        </div>

    </div>

</section>

{% endblock %}