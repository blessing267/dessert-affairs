<!doctype html>
<html {{ site.language_attributes }}>
	<head>
		<meta charset="{{ site.charset }}">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% if wp_title %}
				{{ wp_title }}
				|
			{% endif %}
			{{ site.name }}</title>
		{{ function('wp_head') }}
	</head>
	<body class="{{ body_class }}">
		<header class="site-header">

    <div class="container header-inner">

        <!-- Logo -->
        <div class="site-branding">
            <a
                href="{{ site.url }}"
                class="site-logo"
                aria-label="{{ site.name }} home"
            >
                <img
                    src="{{ theme.link }}/assets/images/logo.png"
                    alt="{{ site.name }}"
                    class="site-logo-image"
                >
            </a>
        </div>


        <!-- DESKTOP NAVIGATION -->
        <nav
            class="desktop-navigation"
            aria-label="Main navigation"
        >

            <a
                href="{{ site.url }}"
                class="desktop-nav-item
                {{ function('is_front_page') ? 'is-active' : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                        d="M3 11L12 4L21 11"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M5.5 10V20H18.5V10"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M9.5 20V14H14.5V20"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                </svg>

                <span>Home</span>
            </a>


            <a
                href="{{ site.url }}/about/"
                class="desktop-nav-item
                {{ function('is_page', 'about') ? 'is-active' : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle
                        cx="12"
                        cy="12"
                        r="9"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                    <path
                        d="M12 10.5V17"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                    <circle
                        cx="12"
                        cy="7.5"
                        r="1"
                        fill="currentColor"
                    />
                </svg>

                <span>About</span>
            </a>


            <a
                href="{{ function('wc_get_page_permalink', 'shop') }}"
                class="desktop-nav-item
                {{ function('is_shop') or function('is_product_category')
                    ? 'is-active'
                    : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                        d="M4 9H20"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                    <path
                        d="M5 9L6.5 4H17.5L19 9"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M5 9V20H19V9"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M9 20V14H15V20"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                </svg>

                <span>Shop</span>
            </a>


            <a
                href="{{ site.url }}/contact/"
                class="desktop-nav-item
                {{ function('is_page', 'contact') ? 'is-active' : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect
                        x="3"
                        y="5"
                        width="18"
                        height="14"
                        rx="2"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                    <path
                        d="M4 7L12 13L20 7"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                </svg>

                <span>Contact</span>
            </a>

        </nav>


        <!-- MOBILE QUICK NAVIGATION -->
        <nav
            class="mobile-quick-nav"
            aria-label="Quick navigation"
        >

            <a
                href="{{ site.url }}"
                class="{{ function('is_front_page') ? 'is-active' : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                        d="M3 11L12 4L21 11"
                        stroke="currentColor"
                        stroke-width="1.9"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M5.5 10V20H18.5V10"
                        stroke="currentColor"
                        stroke-width="1.9"
                    />
                </svg>

                <span>Home</span>
            </a>


            <a
                href="{{ function('wc_get_page_permalink', 'shop') }}"
                class="
                    {{ function('is_shop') or function('is_product_category')
                        ? 'is-active'
                        : '' }}
                "
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                        d="M4 9H20"
                        stroke="currentColor"
                        stroke-width="1.9"
                    />
                    <path
                        d="M5 9L6.5 4H17.5L19 9"
                        stroke="currentColor"
                        stroke-width="1.9"
                    />
                    <path
                        d="M5 9V20H19V9"
                        stroke="currentColor"
                        stroke-width="1.9"
                    />
                </svg>

                <span>Shop</span>
            </a>


            <a href="{{ function('wc_get_page_permalink', 'myaccount') }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle
                        cx="12"
                        cy="8"
                        r="3.5"
                        stroke="currentColor"
                        stroke-width="1.9"
                    />
                    <path
                        d="M5.5 20C5.9 16.4 8.2 14.5 12 14.5C15.8 14.5 18.1 16.4 18.5 20"
                        stroke="currentColor"
                        stroke-width="1.9"
                        stroke-linecap="round"
                    />
                </svg>

                <span>Account</span>
            </a>


            <a
                href="{{ function('wc_get_cart_url') }}"
                class="mobile-cart-link"
            >
                <span class="mobile-icon-wrap">

                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                            d="M6 8H18L19 21H5L6 8Z"
                            stroke="currentColor"
                            stroke-width="1.9"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M9 9V6C9 4.34 10.34 3 12 3C13.66 3 15 4.34 15 6V9"
                            stroke="currentColor"
                            stroke-width="1.9"
                            stroke-linecap="round"
                        />
                    </svg>

                    {% if
                        function('WC')
                        and function('WC').cart
                        and function('WC').cart.get_cart_contents_count() > 0
                    %}
                        <span class="cart-count">
                            {{
                                function('WC').cart
                                .get_cart_contents_count()
                            }}
                        </span>
                    {% endif %}

                </span>

                <span>Cart</span>
            </a>

        </nav>


        <!-- DESKTOP ACCOUNT / CART + MOBILE HAMBURGER -->
        <div class="header-actions">

            {% if function('class_exists', 'WooCommerce') %}

                <a
                    href="{{ function('wc_get_page_permalink', 'myaccount') }}"
                    class="header-icon-link desktop-account-link"
                    aria-label="My Account"
                >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle
                            cx="12"
                            cy="8"
                            r="3.5"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                        <path
                            d="M5.5 20C5.9 16.4 8.2 14.5 12 14.5C15.8 14.5 18.1 16.4 18.5 20"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                        />
                    </svg>
                </a>


                <a
                    href="{{ function('wc_get_cart_url') }}"
                    class="header-icon-link desktop-cart-link"
                    aria-label="Shopping cart"
                >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                            d="M6 8H18L19 21H5L6 8Z"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M9 9V6C9 4.34 10.34 3 12 3C13.66 3 15 4.34 15 6V9"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                        />
                    </svg>

                    {% if
                        function('WC')
                        and function('WC').cart
                        and function('WC').cart.get_cart_contents_count() > 0
                    %}
                        <span class="cart-count">
                            {{
                                function('WC').cart
                                .get_cart_contents_count()
                            }}
                        </span>
                    {% endif %}
                </a>

            {% endif %}


            <button
                class="menu-toggle"
                type="button"
                aria-controls="mobile-navigation"
                aria-expanded="false"
                aria-label="Open navigation menu"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>

    </div>


    <!-- HAMBURGER PANEL -->
    <nav
        class="mobile-navigation"
        id="mobile-navigation"
        aria-label="Mobile navigation"
    >

        <div class="mobile-navigation-inner">

            <a
                href="{{ site.url }}"
                class="{{ function('is_front_page') ? 'is-active' : '' }}"
            >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 11L12 4L21 11" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M5.5 10V20H18.5V10" stroke="currentColor" stroke-width="1.7"/>
                </svg>

                <span>Home</span>
            </a>

            <a href="{{ site.url }}/about/">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M12 10.5V17" stroke="currentColor" stroke-width="1.7"/>
                    <circle cx="12" cy="7.5" r="1" fill="currentColor"/>
                </svg>

                <span>About</span>
            </a>

            <a href="{{ function('wc_get_page_permalink', 'shop') }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 9H20" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M5 9L6.5 4H17.5L19 9" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M5 9V20H19V9" stroke="currentColor" stroke-width="1.7"/>
                </svg>

                <span>Shop</span>

            </a>

            <a href="{{ site.url }}/contact/">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M4 7L12 13L20 7" stroke="currentColor" stroke-width="1.7"/>
                </svg>

                <span>Contact</span>
            </a>


            {% if function('class_exists', 'WooCommerce') %}

                <a
                    href="{{ function('wc_get_cart_url') }}"
                    class="mobile-menu-cart-button"
                >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 8H18L19 21H5L6 8Z" stroke="currentColor" stroke-width="1.7"/>
                        <path d="M9 9V6C9 4.34 10.34 3 12 3C13.66 3 15 4.34 15 6V9" stroke="currentColor" stroke-width="1.7"/>
                    </svg>

                    <span>
                        View Cart

                        {% if
                            function('WC')
                            and function('WC').cart
                            and function('WC').cart.get_cart_contents_count() > 0
                        %}
                            ({{
                                function('WC').cart
                                .get_cart_contents_count()
                            }})
                        {% endif %}
                    </span>
                </a>


                <a
                    href="{{ function('wc_get_page_permalink', 'myaccount') }}"
                    class="mobile-menu-account-button"
                >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/>
                        <path d="M5.5 20C5.9 16.4 8.2 14.5 12 14.5C15.8 14.5 18.1 16.4 18.5 20" stroke="currentColor" stroke-width="1.7"/>
                    </svg>

                    <span>My Account</span>
                </a>

            {% endif %}


            <div class="mobile-follow">

    <span>Follow us</span>

    <div class="mobile-socials">

        {% if instagram_url %}
            <a
                href="{{ instagram_url }}"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
            >
                <img
                    src="{{ theme.link }}/assets/images/icons/instagram.png"
                    alt=""
                    aria-hidden="true"
                >
            </a>
        {% endif %}

        {% if facebook_url %}
            <a
                href="#"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
            >
                <img
                    src="{{ theme.link }}/assets/images/icons/facebook.png"
                    alt=""
                    aria-hidden="true"
                >
            </a>
        {% endif %}

        {% if tiktok_url %}
            <a
                href="{{ tiktok_url }}"
                target="_blank"
                rel="noopener"
                aria-label="TikTok"
            >
                <img
                    src="{{ theme.link }}/assets/images/icons/tiktok.png"
                    alt=""
                    aria-hidden="true"
                >
            </a>
        {% endif %}

        <a
            href="https://wa.me/2348114643319"
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
        >
            <img
                src="{{ theme.link }}/assets/images/icons/whatsapp.png"
                alt=""
                aria-hidden="true"
            >
        </a>

    </div>

</div>

        </div>

    </nav>

</header>

		<div class="floating-actions">

    <a
        href="https://wa.me/2348114643319"
        class="floating-whatsapp-button"
        target="_blank"
        rel="noopener"
        aria-label="Chat with Dessert Affairs on WhatsApp"
    >
        <img
            src="{{ theme.link }}/assets/images/icons/whatsapp.webp"
            alt=""
            aria-hidden="true"
        >
    </a>

    <a
        href="{{ function(
            'get_post_type_archive_link',
            'product'
        ) }}"
        class="floating-shop-button"
    >
        <span
            class="floating-shop-icon"
            aria-hidden="true"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
            >
                <path
                    d="M6 8H18L19 21H5L6 8Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M9 9V6C9 4.34 10.34 3 12 3C13.66 3 15 4.34 15 6V9"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />
            </svg>
        </span>

        <span>
            Shop Now
        </span>
    </a>

</div>

		<button
    		class="floating-music-button"
    		type="button"
    		aria-label="Play background music"
    		aria-pressed="false"
		>
    		<span
        		class="music-icon"
        		aria-hidden="true"
    		>
        		♪
    		</span>

    		<span class="music-label">
        		Play Music
    		</span>
		</button>

		<audio
    		id="dessert-affairs-music"
    		preload="none"
    		loop
		>
    		<source
        		src="{{ theme.link }}/assets/audio/background.mp3"
        		type="audio/mpeg"
    		>
		</audio>

		<main>
			{% block content %}{% endblock %}
		</main>

		<footer class="site-footer">

			<div class="container footer-grid">

				<div class="footer-brand">

					<a
    					href="{{ site.url }}"
    					class="footer-logo"
					>
    					<img
        					src="{{ theme.link }}/assets/images/logo.png"
        					alt="{{ site.name }}"
    					>
					</a>

					<h3>
						{{ site.name }}
					</h3>

					{% if footer_text %}
						<p>
							{{ footer_text }}
						</p>
					{% endif %}

				</div>


				<div class="footer-links">

					<h4>Explore</h4>

					{{
                		function(
                    		'wp_nav_menu',
                    		{
                        		'theme_location': 'primary',
                        		'container': false,
                        		'menu_class': 'footer-menu',
                        		'fallback_cb': false,
                        		'echo': false
                    		}
                		)
            		}}

				</div>


				<div class="footer-shop">

					<h4>Shop</h4>

					<a href="{{ function( 'wc_get_page_permalink', 'shop' ) }}">
						Shop Desserts
					</a>

					<a href="{{ function( 'wc_get_cart_url' ) }}">
						Cart
					</a>

					<a href="{{ function( 'wc_get_page_permalink', 'myaccount' ) }}">
						My Account
					</a>

				</div>


				<div class="footer-contact">

					<h4>Contact</h4>

					{% if phone_number %}
						<p>
							<a href="tel:{{ phone_number }}">
								{{ phone_number }}
							</a>
						</p>
					{% endif %}

					{% if email_address %}
						<p>
							<a href="mailto:{{ email_address }}">
								{{ email_address }}
							</a>
						</p>
					{% endif %}

					{% if opening_hours %}
						<p class="opening-hours">
							{{ opening_hours }}
						</p>
					{% endif %}

					<div class="social-links">

    {% if instagram_url %}
        <a
            href="{{ instagram_url }}"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
        >
            <img
                src="{{ theme.link }}/assets/images/icons/instagram.png"
                alt=""
                aria-hidden="true"
            >
        </a>
    {% endif %}

    {% if facebook_url %}
        <a
            href="#"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
        >
            <img
                src="{{ theme.link }}/assets/images/icons/facebook.png"
                alt=""
                aria-hidden="true"
            >
        </a>
    {% endif %}

    {% if tiktok_url %}
        <a
            href="{{ tiktok_url }}"
            target="_blank"
            rel="noopener"
            aria-label="TikTok"
        >
            <img
                src="{{ theme.link }}/assets/images/icons/tiktok.png"
                alt=""
                aria-hidden="true"
            >
        </a>
    {% endif %}

    <a
        href="https://wa.me/2348114643319"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
    >
        <img
            src="{{ theme.link }}/assets/images/icons/whatsapp.png"
            alt=""
            aria-hidden="true"
        >
    </a>

</div>

				</div>

			</div>


			<div class="footer-bottom">

				<div class="container">

					<p>
						&copy;
						{{ "now"|date("Y") }}
						{{ site.name }}.
						All rights reserved.
					</p>

				</div>

			</div>

		</footer>
		{{ function('wp_footer') }}
	</body>
</html>
