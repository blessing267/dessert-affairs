<!doctype html>
<html {{ site.language_attributes }}>
	<head>
		<meta charset="{{ site.charset }}">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% if wp_title %}
				{{ wp_title }}
				|
			{% endif %}
			{{ site.name }}</title>
		{{ function('wp_head') }}
	</head>
	<body class="{{ body_class }}">
		<header class="site-header">
			<div class="container header-inner">

				<div class="site-branding">
					<a href="{{ site.url }}" class="site-logo">
						{{ site.name }}
					</a>
				</div>

				<nav class="main-navigation" aria-label="Primary navigation">
					{{
                function(
                    'wp_nav_menu',
                    {
                        'theme_location': 'primary',
                        'container': false,
                        'menu_class': 'nav-menu',
                        'fallback_cb': false,
                        'echo': false
                    }
                )
            }}
				</nav>

				<div class="header-actions">

					{% if function('class_exists', 'WooCommerce') %}

						<a href="{{ function('wc_get_page_permalink', 'myaccount') }}" class="account-link">
							My Account
						</a>

						<a href="{{ function('wc_get_cart_url') }}" class="cart-link">
							Cart

							{% if function('WC') and function('WC').cart %}
								<span class="cart-count">
									{{ function('WC').cart.get_cart_contents_count() }}
								</span>
							{% endif %}
						</a>

					{% endif %}

				</div>

			</div>
		</header>

		<main>
			{% block content %}{% endblock %}
		</main>

		<footer class="site-footer">

			<div class="container footer-grid">

				<div class="footer-brand">

					<h3>
						{{ site.name }}
					</h3>

					{% if footer_text %}
						<p>
							{{ footer_text }}
						</p>
					{% endif %}

				</div>


				<div class="footer-links">

					<h4>Explore</h4>

					{{
                		function(
                    		'wp_nav_menu',
                    		{
                        		'theme_location': 'primary',
                        		'container': false,
                        		'menu_class': 'footer-menu',
                        		'fallback_cb': false,
                        		'echo': false
                    		}
                		)
            		}}

				</div>


				<div class="footer-shop">

					<h4>Shop</h4>

					<a href="{{ function( 'wc_get_page_permalink', 'shop' ) }}">
						Shop Desserts
					</a>

					<a href="{{ function( 'wc_get_cart_url' ) }}">
						Cart
					</a>

					<a href="{{ function( 'wc_get_page_permalink', 'myaccount' ) }}">
						My Account
					</a>

				</div>


				<div class="footer-contact">

					<h4>Contact</h4>

					{% if phone_number %}
						<p>
							<a href="tel:{{ phone_number }}">
								{{ phone_number }}
							</a>
						</p>
					{% endif %}

					{% if email_address %}
						<p>
							<a href="mailto:{{ email_address }}">
								{{ email_address }}
							</a>
						</p>
					{% endif %}

					{% if opening_hours %}
						<p class="opening-hours">
							{{ opening_hours }}
						</p>
					{% endif %}

					<div class="social-links">

						{% if instagram_url %}
							<a href="{{ instagram_url }}" target="_blank" rel="noopener">
								Instagram
							</a>
						{% endif %}

						{% if facebook_url %}
							<a href="{{ facebook_url }}" target="_blank" rel="noopener">
								Facebook
							</a>
						{% endif %}

					</div>

				</div>

			</div>


			<div class="footer-bottom">

				<div class="container">

					<p>
						&copy;
						{{ "now"|date("Y") }}
						{{ site.name }}.
						All rights reserved.
					</p>

				</div>

			</div>

		</footer>
		{{ function('wp_footer') }}
	</body>
</html>
